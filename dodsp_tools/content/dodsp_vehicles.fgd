@PointClass base(DoDSPVehicleBase) studio("models/cod2/vehicles/halftrack_desert.mdl") = dodsp_vehicle_halftrack_desert : "Halftrack (desert) - DOD-SP vehicle (scripts/dodsp_vehicles.txt). Point its front the way it should start facing." []
