// DOD-SP vehicles for Hammer. Add this file to your DOD-SP game configuration (Tools > Options >
// Game Configurations > Game Data files > Add), next to the base FGDs.
// Place a dodsp_vehicle_<type> (one per vehicle, with its own preview); the plain dodsp_vehicle + "vehicletype" still works.
@include "base.fgd"

@BaseClass base(Targetname, Angles) = DoDSPVehicleBase
[
	riders(choices) : "Riders" : "0" : "Spawn with its full riding complement: soldiers of its side on every seat in scripts/dodsp_vehicles.txt (tank deck / troop bay). Stage V3 - until it's built the option is kept and the console says no riders were spawned." =
	[
		"0" : "No riders"
		"1" : "Full riding complement"
	]
	goal(target_destination) : "Drive to at start" : "" : "Optional: an entity it drives to when the map starts."
	behavior(choices) : "Behaviour" : "offensive" : "Offensive: hunts, closes in, shoots on the move. Defensive: holds long-range spots, stops to shoot, backs away from what gets close, stays in its leash. Hold: stays put. Scripted: moves only on inputs." =
	[
		"offensive" : "Offensive"
		"defensive" : "Defensive"
		"hold" : "Hold position"
		"scripted" : "Scripted (inputs only)"
	]
	leash(float) : "Leash" : "0" : "How far (units) from where it starts it may go. 0 = anywhere (defensive: 2000)."
	faction(choices) : "Side" : "" : "Who it fights for. Empty = the type's own side (German vehicles axis, Allied ones allies)." =
	[
		"" : "The type's side"
		"axis" : "Axis (German)"
		"allies" : "Allies (American, British, Russian)"
	]

	input DriveTo(string) : "Drive to the named entity (over the AI nodes)."
	input Stop(void) : "Stop where it is."
	input SetMaxSpeed(float) : "Scale its top speed (1 = the type's, 0.5 = half)."
	input SetTarget(string) : "Shoot at this entity (if it's on the other side) instead of choosing."
	input ClearTarget(void) : "Choose its own targets again."
	input HoldFire(void) : "Stop firing (it still aims)."
	input OpenFire(void) : "Fire again."

	output OnArrived(void) : "Reached the goal."
	output OnStuck(void) : "Couldn't move for 3 s (it plans around the spot by itself)."
	output OnNoRoute(void) : "No route to the goal for a vehicle this wide."
	output OnTargetSeen(void) : "Picked a new target (the activator)."
	output OnFire(void) : "Fired its main gun (the activator is the target)."
	output OnPenetrated(void) : "A round got through its armour (the activator fired it)."
	output OnImmobilized(void) : "Engine, tracks or driver gone - it can't move any more."
	output OnBailOut(void) : "The crew got out (German crews come out as soldiers)."
	output OnKnockedOut(void) : "Out of the fight: burning, abandoned or wrecked (fires once)."
]

// Everything below is GENERATED from scripts/dodsp_vehicles.txt by dodsp_tools/gen_vehicle_fgd.py (the lint checks it is
// up to date). One class per vehicle type, so Hammer shows that vehicle WITH its turret (models/dodsp/editor/<type>.mdl,
// compiled from the editor-model pack - Hammer only; the game never spawns it).
// BEGIN GENERATED
@PointClass base(DoDSPVehicleBase) studio("models/cod2/vehicles/panzer2_hull.mdl") = dodsp_vehicle :
	"DOD-SP armoured vehicle, type chosen by a key (the preview is always the Panzer II). Prefer the dodsp_vehicle_<type> classes: they show the right vehicle."
[
	vehicletype(choices) : "Vehicle type" : "panzer2" : "A block in scripts/dodsp_vehicles.txt." =
	[
		"panzer2" : "Panzer II"
		"panzer2_winter" : "Panzer II (winter)"
		"tiger" : "Tiger"
		"tiger_brush" : "Tiger (brush camouflage)"
		"sherman" : "Sherman"
		"sherman_desert" : "Sherman (desert)"
		"crusader" : "Crusader"
		"armoredcar" : "Armoured car (Sd.Kfz. 222)"
		"halftrack" : "Halftrack (Sd.Kfz. 251)"
		"halftrack_desert" : "Halftrack (desert)"
		"halftrack_snow" : "Halftrack (snow)"
		"halftrack_rockets" : "Halftrack (rockets)"
		"carrier" : "Bren carrier"
	]
]

@PointClass base(DoDSPVehicleBase) studio("models/dodsp/editor/panzer2.mdl") = dodsp_vehicle_panzer2 : "Panzer II - DOD-SP vehicle (scripts/dodsp_vehicles.txt). Point its front the way it should start facing." []
@PointClass base(DoDSPVehicleBase) studio("models/dodsp/editor/panzer2_winter.mdl") = dodsp_vehicle_panzer2_winter : "Panzer II (winter) - DOD-SP vehicle (scripts/dodsp_vehicles.txt). Point its front the way it should start facing." []
