//-----------------------------------------------------------------------------
//	game_shader_dodsp.vpc
//
//	DOD-SP's own shader DLL (lighting stage 3).
//
//	INVARIANT: this DLL sits NEXT TO Mapbase's game_shader_dx9.dll and never replaces it.
//	  - Its file name is game_shader_dx6.dll. The SDK 2013 SP engine loads exactly
//	    game_shader_dx6.dll .. game_shader_dx9.dll from the mod's bin folder; Mapbase owns dx9,
//	    nobody ships dx6. Tested in game (stage 3a): game_shader_generic*.dll is NOT loaded by
//	    this engine, even though older code and the 2025 MP SDK use that name - don't go back to it.
//	  - It registers only DODSP_* shaders and only uses dodsp_*.vcs shader files, so it
//	    can never take over one of Mapbase's SDK_* shaders or a Valve shader.
//	  - It must NOT include game_shader_dx9_mapbase.vpc (that would register a second copy
//	    of every SDK_* shader, and the last DLL loaded wins).
//	Uninstall: delete DOD-SP\bin\game_shader_dx6.dll (and later DOD-SP\shaders\fxc\dodsp_*.vcs).
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME		"mod_hl2"
$Macro OUTBINNAME	"game_shader_dx6"
$Macro OUTBINDIR	"$SRCDIR\..\game\$GAMENAME\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration	"Debug"
{
	$General
	{
		$OutputDirectory		"Debug_dodsp_$GAMENAME"			[$WIN32]
		$IntermediateDirectory	"Debug_dodsp_$GAMENAME"			[$WIN32]
	}
}

$Configuration	"Release"
{
	$General
	{
		$OutputDirectory		"Release_dodsp_$GAMENAME"		[$WIN32]
		$IntermediateDirectory	"Release_dodsp_$GAMENAME"		[$WIN32]
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.;fxctmp9;vshtmp9"	[$WIN32||$POSIX]
		$PreprocessorDefinitions		"$BASE;STDSHADER_DX9_DLL_EXPORT;FAST_MATERIALVAR_ACCESS;DODSP_SHADER_DLL"
		$PreprocessorDefinitions		"$BASE;USE_ACTUAL_DX" [($WIN32||$X360) && !$GL]
	}

	$Linker
	{
		$AdditionalDependencies			"$BASE version.lib winmm.lib"	[$WIN32]
	}
}

$Project "Shaders (DOD-SP)"
{
	$Folder	"Source Files"
	{
		// Shared helper code only; it registers no shaders. Its ConVars (mat_fullbright,
		// mapbase_version_shaders, ...) have the same names as the ones in Mapbase's DLL, and the
		// engine links ConVars with the same name into one, so both DLLs read the same values.
		$File	"BaseVSShader.cpp"

		$Folder	"DOD-SP"
		{
			$File	"dodsp\dodsp_probe.cpp"
			$File	"dodsp\dodsp_suncascadedebug.cpp"
		}
	}

	$Folder	"Header Files"
	{
		$File	"BaseVSShader.h"
		$File	"common_fxc.h"
		$File	"common_hlsl_cpp_consts.h"
		$File	"common_ps_fxc.h"
		$File	"common_vs_fxc.h"
		$File	"shader_constant_register_map.h"
		$File	"$SRCDIR\public\dodsp_shaders.h"
		$File	"dodsp\dodsp_screenspace_vs30.inc"
		$File	"dodsp\dodsp_suncascadedebug_ps30.inc"
	}

	// The .fxc files listed in dodsp_shaders_dx9_30.txt are compiled to shaders\fxc\dodsp_*.vcs by
	// ShaderCompile2 in CI (mapbase_build-base.yml), not by this project (VPC would attach Valve's
	// old perl build steps to .fxc files). The .inc headers above are hand-written and must match
	// each .fxc's // STATIC / // DYNAMIC lines; the CI checks the combo counts.

	$Folder "Link Libraries"
	{
		$Lib	mathlib
		$Lib	shaderlib
	}
}
